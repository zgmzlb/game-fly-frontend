:: 寻找本子 {"position":"650,925","size":"100,100"}
<div class="scene-container" onclick="nextDialogue(event, 'puzzleIntro')">
    <div class="scene-img">[img[第一章-祖父的房间-解谜.png]]</div>
    <div class="text-overlay">
        <span id="dialogue-puzzleIntro"></span>
        
        <div style="margin-top: 30px;" onclick="event.stopPropagation()">
            <<textbox "$player_input" "">>
            <<button "调查">>
                <<run 
                    fetch("https://643e3f18.r18.cpolar.top/api/puzzle1", {
                        method: "POST",
                        headers: {"Content-Type": "application/json"},
                        body: JSON.stringify({input: State.variables.player_input})
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.state) {
                            Object.keys(data.state).forEach(key => {
                                State.variables[key] = data.state[key];
                            });
                        }
                        
                        window.stopTypeText('puzzleIntro');
                        
                        const element = document.getElementById("dialogue-puzzleIntro");
                        element.innerHTML = "";
                        
                        if (data.cg) {
                            // 有CG：直接显示HTML
                            let displayHTML = '<div class="cg-display"><img src="images/' + data.cg + '.png" style="max-width:100%; margin-bottom:10px;"></div>';
                            displayHTML += data.content.replace(/\n/g, '<br>');
                            element.innerHTML = displayHTML;
                        } else {
                            // 无CG：逐字显示
                            window.typeText(element, data.content, 0, 'puzzleIntro-response', true);
                        }
                        
                        if (data.type === "success") {
                            setTimeout(() => {
                                Engine.play("获得笔记本");
                            });
                        }
                    });
                >>
            <</button>>
        </div>
    </div>
</div>

<script>
window.dialogues = window.dialogues || {};
window.dialogues["puzzleIntro"] = [
    "你站在祖父的书桌前，香炉里的香已经燃尽。",
    "爷爷留给你的本子，到底藏在哪呢？"
];

setTimeout(() => window.initDialogue && window.initDialogue("puzzleIntro"), 50);
</script>


