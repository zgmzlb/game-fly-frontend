:: StoryScript [script]
// ========== 全局逐字显现引擎 ==========

// 逐字显示函数
window.typeText = function(element, text, index = 0, sceneId) {
    if (index < text.length) {
        element.innerHTML += text.charAt(index);
        window.timeouts = window.timeouts || {};
        window.timeouts[sceneId] = setTimeout(() => window.typeText(element, text, index + 1, sceneId), 40);
    }
};

// 停止逐字动画
window.stopTypeText = function(sceneId) {
    if (window.timeouts && window.timeouts[sceneId]) {
        clearTimeout(window.timeouts[sceneId]);
        delete window.timeouts[sceneId];
    }
};

// 点击处理函数
window.nextDialogue = function(event, sceneId) {
    if (event.target.tagName === 'A' || event.target.tagName === 'BUTTON' || event.target.tagName === 'INPUT') return;
    
    if (!window.dialogues || !window.dialogues[sceneId]) return;
    if (!window.dialogueIndex) window.dialogueIndex = {};
    if (window.dialogueIndex[sceneId] === undefined) window.dialogueIndex[sceneId] = 0;
    
    // 停止当前逐字动画
    window.stopTypeText(sceneId);
    
    const element = document.getElementById("dialogue-" + sceneId);
    if (!element) return;
    
    // 如果当前句子还没显示完，直接显示完整句子
    if (window.dialogues[sceneId][window.dialogueIndex[sceneId]] && 
        element.innerHTML.length < window.dialogues[sceneId][window.dialogueIndex[sceneId]].length) {
        element.innerHTML = window.dialogues[sceneId][window.dialogueIndex[sceneId]];
        return;
    }
    
    // 当前句子已经显示完，进入下一句
    window.dialogueIndex[sceneId]++;
    
    if (window.dialogueIndex[sceneId] < window.dialogues[sceneId].length) {
        element.innerHTML = "";
        window.typeText(element, window.dialogues[sceneId][window.dialogueIndex[sceneId]], 0, sceneId);
    } else {
        element.innerHTML = "";
        // 显示按钮（如果有）
        const buttons = document.getElementById(sceneId + "-buttons");
        if (buttons) buttons.style.display = "block";
        // 显示链接（如果有）
        const link = document.getElementById("link-" + sceneId);
        if (link) link.style.display = "block";
    }
};

// 初始化指定场景
window.initDialogue = function(sceneId) {
    const element = document.getElementById("dialogue-" + sceneId);
    if (element && window.dialogues && window.dialogues[sceneId]) {
        // 重置索引
        window.dialogueIndex = window.dialogueIndex || {};
        window.dialogueIndex[sceneId] = 0;
        element.innerHTML = "";
        window.stopTypeText(sceneId);
        window.typeText(element, window.dialogues[sceneId][0], 0, sceneId);
        return true;
    }
    return false;
};

// 自动初始化当前页面的所有对话
window.autoInitDialogues = function() {
    if (!window.dialogues) window.dialogues = {};
    if (!window.dialogueIndex) window.dialogueIndex = {};
    
    // 遍历所有可能的对话ID
    const dialogueElements = document.querySelectorAll('[id^="dialogue-"]');
    dialogueElements.forEach(element => {
        const sceneId = element.id.replace("dialogue-", "");
        if (window.dialogues[sceneId] && window.dialogueIndex[sceneId] === undefined) {
            window.dialogueIndex[sceneId] = 0;
            element.innerHTML = "";
            window.typeText(element, window.dialogues[sceneId][0], 0, sceneId);
        }
    });
};

// 页面加载时初始化
document.addEventListener("DOMContentLoaded", window.autoInitDialogues);

// 每次节点变化时尝试初始化（关键！）
setInterval(window.autoInitDialogues, 200);

:: StoryStylesheet [stylesheet]
/* 场景总容器 */
.scene-container {
    position: relative;
    width: 100%;
    height: 95vh; 
    background-color:#e8d9c5;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

/* 图片适配：确保图片完整显示 */
.scene-img {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}

.scene-img img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain; 
    display: block;
}

/* 基础对话框样式 */
.text-overlay {
    position: absolute;
    bottom: 5%;
    width: 90%;
    max-width: 800px;
    min-height: 100px;
    background-image: url('对话框_当代.png');
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position: center;
    padding: 25px 35px;  /* 根据你的图片调整内边距，让文字不压边 */
    color: #000000;
    font-size: 1.1rem;
    line-height: 1.5;
    text-align: left;
    box-sizing: border-box;
    z-index: 10;
    pointer-events: auto;
    /* 去掉原来的背景色和边框 */
    /* background: rgba(0, 0, 0, 0.7); */
    /* border: 1px solid rgba(255, 255, 255, 0.1); */
}

/* 链接样式 */
.text-overlay a {
    color: #00ccff;
    text-decoration: none;
}